[options]
mode bmc
depth 1

[engines]
smtbmc yices

[script]
verilog_defaults -add -I.

# Read standard design RTL files normally as SystemVerilog
read -sv defs/mmu_defs.sv
read -sv core/mmu_core.sv
read -sv module/tt_anti_glitch_filter.sv
read -sv tt_um_c061618g2.sv

# Read verification files explicitly with the formal flag enabled
read -formal defs/mmu_defs_formal.sv
read -formal core/mmu_core_formal.sv
read -formal module/tt_anti_glitch_filter_formal.sv
read -formal tt_um_c061618g2_formal.sv

# Elaborate the hierarchy using your top-level formal module name
prep -top tt_um_c061618g2_formal

[files]
# Target Destination Path              # Local Source Repository Path
defs/mmu_defs.sv                        ../src/defs/mmu_defs.sv
core/mmu_core.sv                        ../src/core/mmu_core.sv
module/tt_anti_glitch_filter.sv        ../src/module/tt_anti_glitch_filter.sv
tt_um_c061618g2.sv                      ../src/tt_um_c061618g2.sv
src/defs/mmu_defs.sv                        ../src/defs/mmu_defs.sv
src/core/mmu_core.sv                        ../src/core/mmu_core.sv
src/module/tt_anti_glitch_filter.sv        ../src/module/tt_anti_glitch_filter.sv
defs/mmu_defs_formal.sv defs/mmu_defs_formal.sv
core/mmu_core_formal.sv core/mmu_core_formal.sv
module/tt_anti_glitch_filter_formal.sv module/tt_anti_glitch_filter_formal.sv
tt_um_c061618g2_formal.sv tt_um_c061618g2_formal.sv
