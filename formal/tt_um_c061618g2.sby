[options]
mode bmc
depth 1


[engines]
# High-speed native SMT-solver engine matrix
#smtbmc --unroll z3
#smtbmc yices
# Bypasses the smt2 backend entirely, while still utilizing a 
# high-performance Z3/Boolector-class solver backend (btormc)
btor btormc

[script]
verilog_defaults -add -I.

# 0. READ THE IHP STANDARD CELL BLACKBOXES FIRST
# This macro tells Yosys to strip out specify/timing blocks from the primitives
#read_verilog -formal -lib sg13g2_stdcell_clean.v

# -------------------------------------------------------------------------
# READ THE IDEAL TRANSISTOR CELLS FIRST
# This forces Yosys to see real internal assign structures, 
# completely removing the "is a blackbox/whitebox module" compilation error.
# -------------------------------------------------------------------------
read_verilog -sv lib/cells_formal.sv

# 1. Read standard design RTL files normally as SystemVerilog
read -sv defs/mmu_defs.sv
read -sv core/mmu_core.sv
#read -sv module/safe_async_mux.sv
read -sv module/async_latch_cell.sv
read -sv module/async_glitch_filter.sv
read -sv module/async_glitch_filter_bank.sv
#read -sv module/c061618g2_input_shield.sv
read -sv module/c061618g2.sv

read -sv tt_um_c061618g2.sv

# 2. Read all three exhaustive formal verification layers
read -formal defs/mmu_defs_formal.sv
read -formal core/mmu_core_formal.sv
#read -formal module/safe_async_mux_formal.sv
read -formal module/async_latch_cell_formal.sv
read -formal module/async_glitch_filter_formal.sv
read -formal module/async_glitch_filter_bank_formal.sv
#read -formal module/c061618g2_input_shield_formal.sv
read -formal tt_um_c061618g2_formal.sv


# Standard, clean, un-hacked macro elaboration pass
#prep -top tt_um_c061618g2
#clk2fflogic

# =========================================================================
# THE TRUE SBY COMPILER PASS RESOLUTION
# We unpack the automated prep command to run synthesis and split the 
# port arrays. This resolves the write_smt2 circular loop crash natively.
# =========================================================================
# -------------------------------------------------------------------------
# SBY COMPILER PASS RESOLUTION
# Added the -generate flag to automatically stub out the missing IHP gates
# as ideal structural blackboxes, bypassing the PDK file completely.
# -------------------------------------------------------------------------
#hierarchy -generate sg13g2_* O:X O:Y O:Q I:A I:B I:D I:G I:S I:I I:A0 I:A1
##hierarchy -top tt_um_c061618g2
hierarchy -top tt_um_c061618g2 -purge_lib
proc

# =========================================================================
# CRITICAL FLATTENING ADJUSTMENT
# Using 'flatten -wb' (whitebox flatten) tells Yosys to merge the modules 
# but preserve port boundaries as formal cuts. This completely breaks the 
# cross-module combinational feedback loop, preventing simplemap_bitop 
# from crashing!
# =========================================================================
flatten

# 1. Fully synthesize the behavior to break high-level logic loops
#synth -noabc

# Optimize the flattened logical gate tree structures
##opt_expr
##opt_clean
##check

# 2. Convert raw gates into standard library cells so loops are generic
techmap
simplemap

# =========================================================================
# ASYNCHRONOUS LOOP SOLUTION
# async2sync replaces unclocked loop feedback nodes with isolated formal 
# elements. This allows the smt2 backend to evaluate your truth tables 
# cleanly without throwing circular logic loop crashes!
# =========================================================================
#async2sync

# Map tech primitives and isolate ports cleanly
splitnets -ports
#setundef -undriven -expose
#scc -set_attr loop_break 1
#opt_expr
#techmap
#abc
#opt_clean

# 1. Manually break continuous combinatorial loops by inserting
# a formal register mapping to isolate the latch paths
scc -set_attr formal_keep 1

# =========================================================================
# THE ULTIMATE SMT2 FEEDBACK MATRIX BREAKOUT
# This native Yosys pass extracts unclocked combinatorial feedback cycles 
# and wraps them as transparent behavioral latch properties in tool memory.
# This prevents simplemap_bitop from generating the fatal cell $303 crash!
# =========================================================================
#scc -set_attr loop_break 1
#opt_clean

# === ASYNC LATCH LOOPS ===
# This finds loops and breaks them with formal-only variables 
# so the SMT2 backend can output the design cleanly.
#scc -all_cell_types

# Finalize the formal execution logic maps
clk2fflogic

# === THE DEFINITIVE FIX FOR THE LOGIC LOOP ERROR ===
# Detects feedback networks and simplifies word widths to eliminate 
# false multidimensional loops before the SMT2 graph check.
#wreduce
#clean

# Standard formal elaboration mapping without port splitting
#flatten
#prep -top tt_um_c061618g2 -nordff
#prep -top tt_um_c061618g2
##chformal -early
##opt_clean

# =========================================================================
# Uses the native 'cutpoint' pass. Paths must use forward slashes (/) instead 
# of dots (.), ensuring the SMT2 math engine can compile your address 
# decoding truth tables seamlessly without logic loop crashes.
# =========================================================================
##cutpoint w:u_c061618g2.uo_out

# =========================================================================
# THE ULTIMATE CORE MODULE LOOP BREAKOUT MATRIX
# Running scc at the absolute bottom captures the loops formed by the 
# clockless assertion tracking nets, permanently destroying cell $231!
# =========================================================================
#wreduce
#scc -set_attr loop_break 1
##opt_expr
##opt_clean

# 4. Inject structural formal-only variable registers to break the loops 
#clk2fflogic

# 5. Clean and check the netlist without regenerating loops
clean
check

