[options]
mode bmc
depth 1

[engines]
smtbmc yices

[script]
verilog_defaults -add -I.

# 0. READ THE IHP STANDARD CELL BLACKBOXES FIRST
#read_verilog -lib /home/runner/ttsetup/pdk/ihp-sg13g2/libs.ref/sg13g2_stdcell/verilog/sg13g2_stdcell.v
#read_verilog -lib /home/runner/.openlane/pdk/ihp-sg13g2/libs.ref/sg13g2/verilog/sg13g2_stdcell.v
#read_verilog -lib /home/runner/.openlane/pdk/ihp-sg13g2/libs.ref/sg13g2_stdcell/verilog/sg13g2_stdcell.v
#read_verilog -lib /opt/pdk/ihp-sg13g2/libs.ref/sg13g2/verilog/sg13g2_stdcell.v
#read_verilog -lib $PDK_ROOT/ihp-sg13g2/libs.ref/sg13g2_stdcell/verilog/sg13g2_stdcell.v
read_verilog -lib sg13g2_stdcell.v

# 1. Read standard design RTL files normally as SystemVerilog
read -sv defs/mmu_defs.sv
read -sv core/mmu_core.sv
read -sv module/safe_async_mux.sv
read -sv module/async_latch_cell.sv
read -sv module/async_glitch_filter.sv
read -sv module/async_glitch_filter_bank.sv
read -sv module/c061618g2.sv
read -sv tt_um_c061618g2.sv

# 2. Read all three exhaustive formal verification layers
read -formal defs/mmu_defs_formal.sv
read -formal core/mmu_core_formal.sv
read -formal module/safe_async_mux_formal.sv
read -formal module/async_latch_cell_formal.sv
read -formal module/async_glitch_filter_formal.sv
read -formal module/async_glitch_filter_bank_formal.sv
read -formal tt_um_c061618g2_formal.sv


# Standard, clean, un-hacked macro elaboration pass
#prep -top tt_um_c061618g2
#clk2fflogic

# =========================================================================
# THE TRUE SBY COMPILER PASS RESOLUTION
# We unpack the automated prep command to run synthesis and split the 
# port arrays. This resolves the write_smt2 circular loop crash natively.
# =========================================================================
hierarchy -top tt_um_c061618g2
proc
flatten

# Optimize the flattened logical gate tree structures
opt_expr
opt_clean
check

# Execute structural synthesis followed by physical port splitting
synth -top tt_um_c061618g2
splitnets -ports

# Finalize the formal execution logic maps
chformal -early
clk2fflogic

[files]
# Target Destination Path              # Local Source Repository Path
defs/mmu_defs.sv                       ../src/defs/mmu_defs.sv
core/mmu_core.sv                       ../src/core/mmu_core.sv
module/safe_async_mux.sv               ../src/module/safe_async_mux.sv
module/async_latch_cell.sv             ../src/module/async_latch_cell.sv
module/async_glitch_filter.sv          ../src/module/async_glitch_filter.sv
module/async_glitch_filter_bank.sv     ../src/module/async_glitch_filter_bank.sv
module/c061618g2.sv                    ../src/module/c061618g2.sv
tt_um_c061618g2.sv                     ../src/tt_um_c061618g2.sv
src/defs/mmu_defs.sv                   ../src/defs/mmu_defs.sv
src/core/mmu_core.sv                   ../src/core/mmu_core.sv
src/module/safe_async_mux.sv           ../src/module/safe_async_mux.sv
src/module/async_latch_cell.sv         ../src/module/async_latch_cell.sv
src/module/async_glitch_filter.sv      ../src/module/async_glitch_filter.sv
src/module/async_glitch_filter_bank.sv ../src/module/async_glitch_filter_bank.sv
src/module/c061618g2.sv                ../src/module/c061618g2.sv
defs/mmu_defs_formal.sv                    defs/mmu_defs_formal.sv
core/mmu_core_formal.sv                    core/mmu_core_formal.sv
module/safe_async_mux_formal.sv            module/safe_async_mux_formal.sv
module/async_latch_cell_formal.sv          module/async_latch_cell_formal.sv
module/async_glitch_filter_formal.sv       module/async_glitch_filter_formal.sv
module/async_glitch_filter_bank_formal.sv  module/async_glitch_filter_bank_formal.sv
