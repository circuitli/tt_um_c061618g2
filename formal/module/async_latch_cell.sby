[options]
mode bmc
depth 1

[engines]
smtbmc yices

[script]
verilog_defaults -add -I.

# 1. Read the custom UDP cell code mapped into workspace memory
read -sv async_latch_cell.sv

# 2. Read the local standalone primitive checker properties
read -formal async_latch_cell_formal.sv

# 3. Direct the solver engine to target the primitive wrapper block
prep -top async_latch_cell_formal
clk2fflogic

[files]
# Adjusted by exactly one path layer to find your pure source code directory
async_latch_cell.sv                 ../../src/module/async_latch_cell.sv
src/module/async_latch_cell.sv      ../../src/module/async_latch_cell.sv
async_latch_cell_formal.sv          async_latch_cell_formal.sv
